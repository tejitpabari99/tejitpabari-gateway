GATEWAY_PASSWORD=your-password-here
SESSION_SECRET=change-this-to-a-random-secret
# The live box (behind Cloudflare, no nginx/tunnel in front) has cc-gateway
# bind directly to port 80, since Cloudflare's origin firewall only allows
# port 80 in from its own IP ranges. Only use 3002 if you're running the
# alternative nginx-in-front setup described in README.md / deploy/README.md.
PORT=80
ORIGIN=http://your-domain.com
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
