GATEWAY_PASSWORD=your-password-here
SESSION_SECRET=change-this-to-a-random-secret
# The correct PORT depends on the ingress model on the machine you're
# deploying to, and must be verified there, not assumed:
#   - If cc-gateway faces Cloudflare directly, with nothing else listening
#     on 80 in front of it (no nginx/tunnel/local TLS terminator), set
#     PORT=80. Check with `ss -ltnp | grep ':80'` on the target box.
#   - If a reverse proxy (e.g. nginx) fronts cc-gateway and terminates
#     TLS/handles port 80/443 itself, set PORT to the internal port the
#     proxy forwards to, e.g. 3002. Check with `which nginx`,
#     `systemctl status nginx`, and `ls /etc/nginx/sites-enabled/`.
# Whatever is in front of cc-gateway must point at this same port, or the
# site goes down. See README.md's "Live Architecture" section.
PORT=80
ORIGIN=http://your-domain.com
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Base URL of the linkedin-outreach app that cc-gateway proxies /linkedin to.
# Independent of which port cc-gateway itself binds to.
LINKEDIN_URL=http://127.0.0.1:3003
